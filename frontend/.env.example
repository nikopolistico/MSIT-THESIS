# Base URL of the Python backend (no trailing slash). Use an https address when deployed.
# On Vercel set these three variables in the project settings; they are baked in at build time.
VITE_API_BASE_URL=http://localhost:8000

# Supabase (accounts and inventory). Leave empty to disable; the UI then shows "not configured".
# Only the anon/publishable key goes here. The service-role key belongs to the backend and must never be a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
